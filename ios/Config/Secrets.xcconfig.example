// Copy this file to Secrets.xcconfig (same directory) before building a
// release you intend to point at the official bridge — Secrets.xcconfig is
// gitignored and never committed, unlike this example.
//
// Get the current value from wherever ios-bridge is deployed, e.g.:
//   grep IOS_BRIDGE_API_KEY /path/to/ios-bridge/.env
//
// Leave unset (or don't create this file at all) for a build that only
// ever points at a self-hosted bridge — the app already lets a self-host
// operator configure their own key from Settings in that case.
LUMISOUND_BRIDGE_API_KEY =
