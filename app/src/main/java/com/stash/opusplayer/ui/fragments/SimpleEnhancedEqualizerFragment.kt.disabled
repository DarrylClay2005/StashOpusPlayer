package com.stash.opusplayer.ui.fragments

import android.os.Bundle
import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import android.widget.*
import androidx.fragment.app.Fragment
import androidx.fragment.app.viewModels
import androidx.lifecycle.lifecycleScope
import androidx.media3.session.MediaController
import androidx.media3.session.SessionToken
import com.google.common.util.concurrent.MoreExecutors
import com.google.android.material.switchmaterial.SwitchMaterial
import com.stash.opusplayer.R
import com.stash.opusplayer.audio.manager.EqualizerManager
import com.stash.opusplayer.audio.processor.ProfessionalAudioProcessor
import com.stash.opusplayer.audio.SpectrumAnalyzer
import com.stash.opusplayer.service.EnhancedAudioCommands
import com.stash.opusplayer.ui.views.SpectrumView
import com.stash.opusplayer.viewmodels.EnhancedEqualizerViewModel
import kotlinx.coroutines.launch
import kotlin.math.roundToInt

class SimpleEnhancedEqualizerFragment : Fragment() {

    private var rootView: View? = null
    private val viewModel: EnhancedEqualizerViewModel by viewModels()
    private var mediaController: MediaController? = null
    
    // Audio processors
    private var equalizerManager: EqualizerManager? = null
    private var professionalProcessor: ProfessionalAudioProcessor? = null
    private var spectrumAnalyzer: SpectrumAnalyzer? = null
    
    // UI components
    private val bandSliders = mutableListOf<SeekBar>()
    private val bandLabels = mutableListOf<TextView>()
    private val bandValues = mutableListOf<TextView>()

    companion object {
        private const val MAX_SLIDER_VALUE = 1500 // -15dB to +15dB
        private const val SLIDER_OFFSET = 750 // 0dB offset
        
        fun newInstance() = SimpleEnhancedEqualizerFragment()
    }

    override fun onCreateView(
        inflater: LayoutInflater,
        container: ViewGroup?,
        savedInstanceState: Bundle?
    ): View {
        rootView = inflater.inflate(R.layout.fragment_enhanced_equalizer, container, false)
        return rootView!!
    }

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        
        connectToMediaController()
        setupBasicEqualizer()
        setupBasicAudioEffects()
        setupSpectrumAnalyzer()
        observeViewModel()
    }
    
    private fun connectToMediaController() {
        val token = SessionToken(requireContext(), android.content.ComponentName(requireContext(), com.stash.opusplayer.service.MusicService::class.java))
        val future = MediaController.Builder(requireContext(), token).buildAsync()
        future.addListener({
            mediaController = future.get()
        }, MoreExecutors.directExecutor())
    }
    
    private fun setupBasicEqualizer() {
        // Main equalizer switch
        rootView?.findViewById<SwitchMaterial>(R.id.equalizer_switch)?.setOnCheckedChangeListener { _, isChecked ->
            equalizerManager?.setEnabled(isChecked)
            sendCommand(EnhancedAudioCommands.COMMAND_TOGGLE_EQUALIZER, Bundle().apply {
                putBoolean("enabled", isChecked)
            })
        }
        
        // Professional processor switch
        rootView?.findViewById<SwitchMaterial>(R.id.professional_processor_switch)?.setOnCheckedChangeListener { _, isChecked ->
            professionalProcessor?.setEnabled(isChecked)
        }
        
        // Create basic equalizer bands
        createBasicEqualizerBands()
        
        // Setup preset spinner
        setupPresetSpinner()
    }
    
    private fun createBasicEqualizerBands() {
        val bandsContainer = rootView?.findViewById<LinearLayout>(R.id.bands_container)
        bandsContainer?.removeAllViews()
        bandSliders.clear()
        bandLabels.clear()
        bandValues.clear()
        
        equalizerManager?.let { manager ->
            val numberOfBands = manager.numberOfBands
            
            for (i in 0 until numberOfBands) {
                val bandView = createBandView(i)
                bandsContainer?.addView(bandView)
            }
        }
    }
    
    private fun createBandView(bandIndex: Int): View {
        val bandView = layoutInflater.inflate(R.layout.equalizer_band_item, null)
        
        val frequencyLabel = bandView.findViewById<TextView>(R.id.frequency_label)
        val slider = bandView.findViewById<SeekBar>(R.id.band_slider)
        val valueLabel = bandView.findViewById<TextView>(R.id.value_label)
        
        // Set frequency label
        equalizerManager?.let { manager ->
            val centerFreq = manager.getCenterFreq(bandIndex.toShort())
            frequencyLabel.text = formatFrequency(centerFreq)
        }
        
        // Configure slider
        slider.apply {
            max = MAX_SLIDER_VALUE
            progress = SLIDER_OFFSET // 0dB
            setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) {
                    if (fromUser) {
                        val gainDb = (progress - SLIDER_OFFSET) / 50.0f // Convert to dB
                        equalizerManager?.setBandLevel(bandIndex.toShort(), (gainDb * 100).toInt().toShort())
                        valueLabel.text = String.format("%.1f dB", gainDb)
                        
                        sendCommand(EnhancedAudioCommands.COMMAND_SET_BAND_LEVEL, Bundle().apply {
                            putInt("band", bandIndex)
                            putFloat("level", gainDb)
                        })
                    }
                }
                
                override fun onStartTrackingTouch(seekBar: SeekBar?) {}
                override fun onStopTrackingTouch(seekBar: SeekBar?) {}
            })
        }
        
        valueLabel.text = "0.0 dB"
        
        bandSliders.add(slider)
        bandLabels.add(frequencyLabel)
        bandValues.add(valueLabel)
        
        return bandView
    }
    
    private fun formatFrequency(frequency: Int): String {
        return when {
            frequency < 1000 -> "${frequency}Hz"
            frequency < 1000000 -> String.format("%.1fK", frequency / 1000.0)
            else -> String.format("%.1fM", frequency / 1000000.0)
        }
    }
    
    private fun setupBasicAudioEffects() {
        // Bass Boost
        rootView?.findViewById<SeekBar>(R.id.bass_boost_slider)?.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) {
                if (fromUser) {
                    val strength = progress
                    equalizerManager?.setBassBoostStrength(strength.toShort())
                    rootView?.findViewById<TextView>(R.id.bass_boost_value)?.text = "${(progress / 10f).roundToInt()}%"
                    
                    sendCommand(EnhancedAudioCommands.COMMAND_SET_BASS_BOOST, Bundle().apply {
                        putInt("strength", strength)
                    })
                }
            }
            override fun onStartTrackingTouch(seekBar: SeekBar?) {}
            override fun onStopTrackingTouch(seekBar: SeekBar?) {}
        })
        
        // Virtualizer
        rootView?.findViewById<SeekBar>(R.id.virtualizer_slider)?.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) {
                if (fromUser) {
                    val strength = progress
                    equalizerManager?.setVirtualizerStrength(strength.toShort())
                    rootView?.findViewById<TextView>(R.id.virtualizer_value)?.text = "${(progress / 10f).roundToInt()}%"
                    
                    sendCommand(EnhancedAudioCommands.COMMAND_SET_VIRTUALIZER, Bundle().apply {
                        putInt("strength", strength)
                    })
                }
            }
            override fun onStartTrackingTouch(seekBar: SeekBar?) {}
            override fun onStopTrackingTouch(seekBar: SeekBar?) {}
        })
        
        // Stereo Width
        rootView?.findViewById<SeekBar>(R.id.stereo_width_slider)?.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) {
                if (fromUser) {
                    val width = progress / 100f
                    professionalProcessor?.setStereoWidth(width)
                    rootView?.findViewById<TextView>(R.id.stereo_width_value)?.text = "${progress}%"
                }
            }
            override fun onStartTrackingTouch(seekBar: SeekBar?) {}
            override fun onStopTrackingTouch(seekBar: SeekBar?) {}
        })
    }
    
    private fun setupPresetSpinner() {
        equalizerManager?.let { manager ->
            val presets = manager.getPresetNames()
            val adapter = ArrayAdapter(requireContext(), android.R.layout.simple_spinner_item, presets)
            adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
            
            val spinner = rootView?.findViewById<Spinner>(R.id.preset_spinner)
            spinner?.adapter = adapter
            
            spinner?.onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
                override fun onItemSelected(parent: AdapterView<*>?, view: View?, position: Int, id: Long) {
                    manager.usePreset(position.toShort())
                    updateBandSlidersFromPreset(position)
                    
                    sendCommand(EnhancedAudioCommands.COMMAND_SET_PRESET, Bundle().apply {
                        putString("preset", presets[position])
                    })
                }
                
                override fun onNothingSelected(parent: AdapterView<*>?) {}
            }
        }
    }
    
    private fun setupSpectrumAnalyzer() {
        // Initialize spectrum view
        rootView?.findViewById<SpectrumView>(R.id.spectrum_view)?.reset()
    }
    
    private fun observeViewModel() {
        viewLifecycleOwner.lifecycleScope.launch {
            viewModel.spectrumData.collect { spectrum ->
                rootView?.findViewById<SpectrumView>(R.id.spectrum_view)?.updateSpectrum(spectrum)
            }
        }
        
        viewLifecycleOwner.lifecycleScope.launch {
            viewModel.audioMetrics.collect { metrics ->
                rootView?.findViewById<TextView>(R.id.peak_frequency)?.text = 
                    String.format("%.1f kHz", metrics.peakFrequency / 1000f)
                rootView?.findViewById<TextView>(R.id.current_lufs)?.text = 
                    String.format("%.1f", metrics.lufs)
                rootView?.findViewById<TextView>(R.id.dynamic_range)?.text = 
                    String.format("%.1f dB", metrics.dynamicRange)
            }
        }
    }
    
    private fun updateBandSlidersFromPreset(presetIndex: Int) {
        equalizerManager?.let { manager ->
            for (i in bandSliders.indices) {
                val level = manager.getBandLevel(i.toShort())
                val progress = SLIDER_OFFSET + (level / 100f * 50f).toInt()
                bandSliders[i].progress = progress
                bandValues[i].text = String.format("%.1f dB", level / 100f)
            }
        }
    }
    
    private fun sendCommand(command: String, extras: Bundle) {
        mediaController?.sendCustomCommand(
            androidx.media3.session.SessionCommand(command, Bundle.EMPTY),
            extras
        )
    }
    
    // Note: MediaController connection is handled automatically via connectToMediaController()
    // Audio processors are accessed through the MediaController commands

    override fun onDestroyView() {
        super.onDestroyView()
        rootView = null
    }
}