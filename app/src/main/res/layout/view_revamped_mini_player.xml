<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayerCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/mini_player_panel_background"
        android:minHeight="76dp"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:id="@+id/albumArtContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/mini_player_button_subtle_background"
            android:padding="3dp"
            app:layout_constraintBottom_toTopOf="@id/progressContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/albumArt"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Album Art"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note" />

            <View
                android:id="@+id/visualizerView"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_gravity="bottom"
                android:alpha="0.9"
                android:background="@drawable/song_duration_chip_background" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/trackInfoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@id/progressContainer"
            app:layout_constraintEnd_toStartOf="@id/playPauseButton"
            app:layout_constraintStart_toEndOf="@id/albumArtContainer"
            app:layout_constraintTop_toTopOf="@id/albumArtContainer">

            <TextView
                android:id="@+id/trackTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Track Title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/trackArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/song_duration_chip_background"
                android:maxLines="1"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="Artist Name"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/progressContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/albumArtContainer"
            app:layout_constraintEnd_toStartOf="@id/playPauseButton"
            app:layout_constraintStart_toEndOf="@id/albumArtContainer">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

            <SeekBar
                android:id="@+id/progressBar"
                style="@style/Widget.AppCompat.SeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="@color/player_background"
                android:progressTint="@color/secondary_color"
                android:thumbTint="@color/secondary_color" />

            <TextView
                android:id="@+id/totalTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="30dp"
                android:text="0:00"
                android:textColor="@color/text_secondary"
                android:textSize="9sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/albumArtContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/albumArtContainer">

            <ImageButton
                android:id="@+id/previousButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="2dp"
                android:alpha="0.9"
                android:background="@drawable/mini_player_button_subtle_background"
                android:contentDescription="Previous track"
                android:padding="7dp"
                android:src="@drawable/ic_skip_previous"
                android:tint="@color/text_primary" />

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/mini_player_button_accent_background"
                android:contentDescription="Play/Pause"
                android:padding="8dp"
                android:src="@drawable/ic_play_arrow"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/nextButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:alpha="0.9"
                android:background="@drawable/mini_player_button_subtle_background"
                android:contentDescription="Next track"
                android:padding="7dp"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/text_primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
