<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    tools:context=".ui.NowPlayingActivity">

    <!-- Blurred backdrop from album art -->
    <ImageView
        android:id="@+id/backdropImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.35"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtle gradient overlay -->
    <View
        android:id="@+id/backdropScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status bar gradient -->
    <View
        android:id="@+id/statusBarGradient"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/gradient_background"
        app:layout_constraintTop_toTopOf="parent" />
    
    <!-- Visual Feedback Overlay -->
    <TextView
        android:id="@+id/feedbackOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/feedback_overlay_background"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarGradient"
        tools:text="Seeking to 2:15"
        tools:visibility="visible" />

    <!-- Neomorphic Back button -->
    <ImageButton
        android:id="@+id/backButton"
        style="@style/NeomorphicButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_arrow_back_24"
        android:tint="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarGradient" />

    <!-- Neomorphic Options menu -->
    <ImageButton
        android:id="@+id/menuButton"
        style="@style/NeomorphicButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:contentDescription="@string/menu"
        android:src="@drawable/ic_more_vert_24"
        android:tint="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarGradient" />

    <!-- Neomorphic Album artwork -->
    <FrameLayout
        android:id="@+id/albumArtCard"
        style="@style/NeomorphicAlbumArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backButton">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/albumArtwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:contentDescription="@string/album_artwork"
            android:scaleType="centerCrop"
            android:background="@drawable/circular_background"
            android:src="@drawable/ic_music_note"
            app:shapeAppearanceOverlay="@style/RoundedImageView"
            tools:src="@drawable/ic_music_note" />

    </FrameLayout>

    <!-- Song info container -->
    <LinearLayout
        android:id="@+id/songInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/albumArtCard">

        <!-- Song title -->
        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Song Title" />

        <!-- Artist name -->
        <TextView
            android:id="@+id/artistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:text="Artist Name" />

        <!-- Album name -->
        <TextView
            android:id="@+id/albumName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            tools:text="Album Name" />

        <!-- ReplayGain badge -->
        <TextView
            android:id="@+id/replayGainLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_gravity="center"
            android:background="@drawable/duration_background"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="ReplayGain: -5.2 dB" />

    </LinearLayout>

    <!-- Progress container -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/songInfoContainer">

        <!-- Enhanced Real-time Synth Wave visualization -->
        <com.stash.opusplayer.ui.visualizer.EnhancedSynthWaveView
            android:id="@+id/enhancedSynthWaveView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp" />

        <!-- Legacy SeekBar (hidden, kept for compatibility) -->
        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/seek_bar_progress"
            android:thumb="@drawable/seek_bar_thumb" />

        <!-- Time labels -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/currentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="0:00" />

            <TextView
                android:id="@+id/totalTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="3:45" />

        </LinearLayout>

    </LinearLayout>

    <!-- Control buttons container -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressContainer">

        <!-- Neomorphic Shuffle button -->
        <ImageButton
            android:id="@+id/shuffleButton"
            style="@style/NeomorphicButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/shuffle"
            android:src="@drawable/ic_shuffle"
            android:tint="@color/text_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Neomorphic Previous button -->
        <ImageButton
            android:id="@+id/previousButton"
            style="@style/NeomorphicButton.Large"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/previous"
            android:src="@drawable/ic_skip_previous_24"
            android:tint="@color/text_primary" />

        <!-- Neomorphic Play/Pause button -->
        <ImageButton
            android:id="@+id/playPauseButton"
            style="@style/NeomorphicAccentButton"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/play_pause"
            android:src="@drawable/ic_play_arrow_24"
            android:tint="@color/white" />

        <!-- Neomorphic Next button -->
        <ImageButton
            android:id="@+id/nextButton"
            style="@style/NeomorphicButton.Large"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/next"
            android:src="@drawable/ic_skip_next_24"
            android:tint="@color/text_primary" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Neomorphic Repeat button -->
        <ImageButton
            android:id="@+id/repeatButton"
            style="@style/NeomorphicButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_repeat"
            android:tint="@color/text_primary" />

    </LinearLayout>

    <!-- Scrolling container for audio + secondary controls to ensure visibility on all screens -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/controlsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/controlsContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Secondary controls -->
            <LinearLayout
                android:id="@+id/secondaryControlsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Neomorphic Favorite button -->
                <ImageButton
                    android:id="@+id/favoriteButton"
                    style="@style/NeomorphicButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/favorite"
                    android:src="@drawable/ic_favorite_border"
                    android:tint="@color/text_primary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Neomorphic Queue button -->
                <ImageButton
                    android:id="@+id/queueButton"
                    style="@style/NeomorphicButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="@string/queue"
                    android:src="@drawable/ic_queue_music"
                    android:tint="@color/text_primary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Neomorphic Fast Forward button -->
                <ImageButton
                    android:id="@+id/fastForwardButton"
                    style="@style/NeomorphicButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Fast Forward 30s"
                    android:src="@drawable/ic_forward_30_24"
                    android:tint="@color/text_primary" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Neomorphic Metadata toggle button -->
                <ImageButton
                    android:id="@+id/metadataButton"
                    style="@style/NeomorphicButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Show Metadata"
                    android:src="@drawable/ic_text_bubble_24"
                    android:tint="@color/text_primary" />

            </LinearLayout>

            <!-- Metadata view container -->
            <LinearLayout
                android:id="@+id/metadataContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/circular_background"
                android:visibility="gone">

                <!-- Metadata header with back button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Metadata"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/metadataBackButton"
                        style="@style/NeomorphicButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="Back to Controls"
                        android:src="@drawable/ic_arrow_back_24"
                        android:tint="@color/text_primary" />

                </LinearLayout>

                <!-- Metadata content -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxHeight="200dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- File Information -->
                        <TextView
                            android:id="@+id/metadataFileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="File Name:" />

                        <TextView
                            android:id="@+id/metadataFileNameValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Duration -->
                        <TextView
                            android:id="@+id/metadataDuration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="Duration:" />

                        <TextView
                            android:id="@+id/metadataDurationValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Bitrate -->
                        <TextView
                            android:id="@+id/metadataBitrate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="Bitrate:" />

                        <TextView
                            android:id="@+id/metadataBitrateValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Sample Rate -->
                        <TextView
                            android:id="@+id/metadataSampleRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="Sample Rate:" />

                        <TextView
                            android:id="@+id/metadataSampleRateValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Format -->
                        <TextView
                            android:id="@+id/metadataFormat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="Format:" />

                        <TextView
                            android:id="@+id/metadataFormatValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- File Path -->
                        <TextView
                            android:id="@+id/metadataPath"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:text="File Path:" />

                        <TextView
                            android:id="@+id/metadataPathValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
