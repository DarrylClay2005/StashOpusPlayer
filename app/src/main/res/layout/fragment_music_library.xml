<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color"
    android:padding="12dp">

    <!-- Neomorphic Header Card -->
    <LinearLayout
        android:id="@+id/libraryHeader"
        style="@style/NeomorphicCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/libraryHeaderIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_library_music"
            android:layout_marginEnd="10dp"
            app:tint="@color/secondary_color" />

        <TextView
            android:id="@+id/libraryHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Music Library"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/likedButton"
            style="@style/NeomorphicButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            app:icon="@drawable/ic_favorite"
            app:iconTint="@color/accent_color"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchButton"
            style="@style/NeomorphicButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            app:icon="@drawable/ic_search"
            app:iconTint="@color/secondary_color"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sortButton"
            style="@style/NeomorphicButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            app:icon="@drawable/ic_sort"
            app:iconTint="@color/secondary_color"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/layoutButton"
            style="@style/NeomorphicButton"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            app:icon="@drawable/ic_view_list"
            app:iconTint="@color/secondary_color"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanButton"
            style="@style/NeomorphicAccentButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Scan"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/white"
            app:iconSize="14dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <!-- Neomorphic Empty State -->
    <LinearLayout
        android:id="@+id/empty_state_container"
        style="@style/NeomorphicCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_library_music"
            android:layout_marginBottom="12dp"
            app:tint="@color/text_secondary"
            android:alpha="0.6" />

        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No music found"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/empty_state_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan for music files or download from YouTube"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
