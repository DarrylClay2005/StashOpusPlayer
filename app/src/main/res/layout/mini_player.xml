<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="78dp"
    android:layout_marginStart="6dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/mini_player_panel_background"
    android:clickable="true"
    android:clipToPadding="false"
    android:focusable="true"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <ProgressBar
        android:id="@+id/miniProgressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:progressDrawable="@drawable/mini_player_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/miniAlbumArtCard"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/mini_player_button_subtle_background"
        android:padding="3dp"
        app:layout_constraintBottom_toTopOf="@id/miniProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/miniAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/album_artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_note"
            app:shapeAppearanceOverlay="@style/RoundedImageView" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/miniSongInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/miniAlbumArtCard"
        app:layout_constraintEnd_toStartOf="@id/miniControlsContainer"
        app:layout_constraintStart_toEndOf="@id/miniAlbumArtCard"
        app:layout_constraintTop_toTopOf="@id/miniAlbumArtCard">

        <TextView
            android:id="@+id/miniSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="A Long Track Title Lives Here" />

        <TextView
            android:id="@+id/miniArtistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:background="@drawable/song_duration_chip_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="9sp"
            tools:text="Artist Name" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/miniControlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/miniAlbumArtCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/miniAlbumArtCard">

        <ImageButton
            android:id="@+id/miniPreviousButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/mini_player_button_subtle_background"
            android:contentDescription="@string/previous"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous_24"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/miniPlayPauseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/mini_player_button_accent_background"
            android:contentDescription="@string/play_pause"
            android:padding="9dp"
            android:src="@drawable/ic_play_arrow_24"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/miniNextButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/mini_player_button_subtle_background"
            android:contentDescription="@string/next"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next_24"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/miniFastForwardButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/mini_player_button_subtle_background"
            android:contentDescription="Fast Forward 30s"
            android:padding="8dp"
            android:src="@drawable/ic_forward_30_24"
            android:tint="@color/text_primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
