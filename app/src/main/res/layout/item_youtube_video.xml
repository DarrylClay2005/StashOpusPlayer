<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/NeomorphicCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:orientation="horizontal">

    <!-- Neomorphic Thumbnail -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/neomorphic_button_background">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumbnailImageView"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="@drawable/circular_background"
            app:shapeAppearanceOverlay="@style/CircularImageView"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Circular play button overlay -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playOverlayButton"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:background="@drawable/neomorphic_accent_button"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconTint="@color/white"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                android:contentDescription="Play preview" />

    </FrameLayout>

    <!-- Video Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            tools:text="Amazing Music Video Title That Might Be Long" />

        <!-- Channel -->
        <TextView
            android:id="@+id/channelTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="8dp"
            tools:text="Channel Name" />

        <!-- Duration and Views -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/durationTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
                android:textColor="@color/text_secondary"
                android:background="@drawable/duration_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp"
                tools:text="4:13" />

            <TextView
                android:id="@+id/viewsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
                android:textColor="@color/text_secondary"
                tools:text="1.2M views" />

        </LinearLayout>

        <!-- Download Progress (initially hidden) -->
        <LinearLayout
            android:id="@+id/downloadProgressContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/downloadProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:trackColor="@color/surface_variant"
                app:indicatorColor="@color/secondary_color" />

            <TextView
                android:id="@+id/downloadStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.StashWave.Subtitle"
                android:textColor="?attr/colorPrimary"
                tools:text="25%" />

        </LinearLayout>

        <!-- Neomorphic Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previewButton"
                style="@style/NeomorphicButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconTint="@color/text_primary"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                android:contentDescription="Preview" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadButton"
                style="@style/NeomorphicAccentButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/white"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                android:text="Download HQ"
                android:textSize="0sp"
                android:contentDescription="Download" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
