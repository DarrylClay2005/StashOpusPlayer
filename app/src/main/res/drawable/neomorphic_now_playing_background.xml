<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Dark shadow -->
    <item android:top="0dp" android:left="0dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_dark" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    
    <!-- Light shadow -->
    <item android:top="8dp" android:left="8dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_light" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    
    <!-- Main surface -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_color" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    
</layer-list>