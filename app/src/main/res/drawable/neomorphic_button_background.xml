<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state (inverted shadows) -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Inset dark shadow (top-left) -->
            <item android:top="0dp" android:left="0dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/shadow_inset_dark"/>
                </shape>
            </item>
            <!-- Inset light shadow (bottom-right) -->
            <item android:top="4dp" android:left="4dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="@color/shadow_inset_light"/>
                </shape>
            </item>
            <!-- Main surface -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <solid android:color="@color/card_background"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal state -->
    <item>
        <layer-list>
            <!-- Dark shadow (bottom-right) -->
            <item android:top="0dp" android:left="0dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <solid android:color="@color/shadow_dark"/>
                </shape>
            </item>
            <!-- Light shadow (top-left) -->
            <item android:top="6dp" android:left="6dp" android:right="0dp" android:bottom="0dp">
                <shape android:shape="oval">
                    <solid android:color="@color/shadow_light"/>
                </shape>
            </item>
            <!-- Main surface -->
            <item android:top="3dp" android:left="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/card_background"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>